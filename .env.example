# 이 파일을 복사해서 .env.local로 저장하고 실제 값을 채워주세요.
# .env.local은 .gitignore에 의해 커밋되지 않습니다.

# Supabase — 클라이언트/서버 공용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — 서버 전용. app/api/cron/cleanup-logs 라우트가 전체 사용자를 대상으로
# RLS를 우회해 무료 등급의 30일 초과 대화 기록을 지우는 데만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=

# app/api/cron/cleanup-logs를 호출할 수 있는 유일한 인증 수단(Vercel Cron이 자동으로
# `Authorization: Bearer $CRON_SECRET` 헤더를 붙여 호출). 임의의 긴 무작위 문자열로 설정하세요.
CRON_SECRET=

# OpenAI — /api/chat, /api/analyze에서 gpt-4.1-mini 호출에 사용
OPENAI_API_KEY=

# Tavily — 선택 사항. 없으면 "최신 정보 검색" 블록이 검색 없이 안내 문구만 반환합니다.
TAVILY_API_KEY=

# Polar — app/api/webhooks/polar가 수신하는 웹훅의 서명을 검증하는 데만 사용합니다
# (Polar 대시보드 → Webhooks → 해당 엔드포인트 설정에서 발급되는 Secret을 그대로 붙여넣으세요).
# 결제 자체는 lib/plan-limits.ts의 POLAR_CHECKOUT_URL(정적 Checkout Link)로 이동시키는
# 구조라 별도의 API 액세스 토큰은 필요 없습니다.
POLAR_WEBHOOK_SECRET=

# app/admin/funnel(전환 퍼널 집계 페이지)의 접근을 이 이메일 하나로만 허용합니다.
# 이 앱엔 admin/역할 개념이 없어서 로그인 이메일과 이 값을 단순 비교합니다 —
# 본인 계정 이메일로 설정하세요.
ADMIN_EMAIL=

# Reddit — app/api/cron/reddit-digest가 지정한 서브레딧의 새 글을 읽기 전용으로
# 가져오는 데만 사용합니다(댓글/게시글 작성 권한 없음). reddit.com/prefs/apps에서
# "create app" → type: script로 만들면 client id/secret이 발급됩니다(redirect uri는
# 아무 값이나 무방 — 읽기 전용이라 실제로 안 씀).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit이 요구하는 형식: "앱이름/버전 (by /u/본인아이디)". 이 헤더가 부실하면 Reddit이
# 요청을 강하게 rate-limit합니다.
REDDIT_USER_AGENT=carrotly-reddit-monitor/1.0 (by /u/본인아이디)

# Resend — app/api/cron/reddit-digest가 하루 한 번 다이제스트 이메일을 보내는 데만
# 사용합니다(resend.com에서 API 키 발급).
RESEND_API_KEY=
# 다이제스트를 받을 주소.
DIGEST_EMAIL_TO=
# 발신 주소 — 본인 도메인을 Resend에 인증하기 전에는 onboarding@resend.dev로도
# 바로 보낼 수 있습니다.
DIGEST_EMAIL_FROM=onboarding@resend.dev
