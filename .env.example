# 이 파일을 복사해서 .env.local로 저장하고 실제 값을 채워주세요.
# .env.local은 .gitignore에 의해 커밋되지 않습니다.

# Supabase — 클라이언트/서버 공용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — 서버 전용. app/api/cron/cleanup-logs 라우트가 전체 사용자를 대상으로
# RLS를 우회해 무료 등급의 30일 초과 대화 기록을 지우는 데만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=

# app/api/cron/cleanup-logs를 호출할 수 있는 유일한 인증 수단(Vercel Cron이 자동으로
# `Authorization: Bearer $CRON_SECRET` 헤더를 붙여 호출). 임의의 긴 무작위 문자열로 설정하세요.
CRON_SECRET=

# OpenAI — /api/chat, /api/analyze에서 gpt-4.1-mini 호출에 사용
OPENAI_API_KEY=

# Tavily — 선택 사항. 없으면 "최신 정보 검색" 블록이 검색 없이 안내 문구만 반환합니다.
TAVILY_API_KEY=

# Polar — app/api/webhooks/polar가 수신하는 웹훅의 서명을 검증하는 데만 사용합니다
# (Polar 대시보드 → Webhooks → 해당 엔드포인트 설정에서 발급되는 Secret을 그대로 붙여넣으세요).
# 결제 자체는 아래 NEXT_PUBLIC_POLAR_CHECKOUT_URL(정적 Checkout Link)로 이동시키는
# 구조라 별도의 API 액세스 토큰은 필요 없습니다.
POLAR_WEBHOOK_SECRET=

# Polar 대시보드에서 만든 정적 Checkout Link 전체 URL(예: https://buy.polar.sh/polar_cl_...).
# NEXT_PUBLIC_ 접두사가 붙은 이유: lib/plan-limits.ts의 getPolarCheckoutUrl()이
# app/page.tsx(클라이언트 컴포넌트) 렌더링 중에 이 값을 직접 읽어서 체크아웃 링크를
# 만들기 때문입니다 — 접두사가 없으면 브라우저에서는 항상 undefined가 됩니다. 비밀 값이
# 아니라(누구나 접근 가능한 결제 페이지 URL) 클라이언트에 노출돼도 안전합니다. 값이
# 없으면 getPolarCheckoutUrl()이 명확한 에러를 던집니다(빈 링크로 조용히 넘어가지 않음) —
# 반드시 설정하세요. 샌드박스로 테스트할 땐 이 값만 Vercel의 Preview 환경변수 스코프에서
# 샌드박스 Checkout Link로 바꾸면 되고, Production 스코프는 건드릴 필요가 없습니다.
NEXT_PUBLIC_POLAR_CHECKOUT_URL=

# app/admin/funnel·app/admin/ai-usage·app/admin/society-codes(및 그 아래
# /api/admin/society-codes)의 접근을 이 이메일 하나로만 허용합니다. 이 앱엔 admin/역할
# 개념이 없어서 로그인 이메일과 이 값을 단순 비교합니다 — 본인 계정 이메일로 설정하세요.
ADMIN_EMAIL=

# 소사이어티 코드(app/admin/society-codes) 킬스위치 — 코드로 Pro가 된 전체 계정의
# 이번 달 토큰 사용량 합계가 이 값을 넘으면 신규 코드 사용(/api/society-code/redeem)이
# 자동으로 막힙니다(이미 코드로 Pro인 계정의 사용은 막지 않음). 값을 비워두면 킬스위치가
# 꺼진 채로 동작합니다(lib/society-codes.ts 참고) — 무제한 예산으로 코드 프로모션을
# 처음 시작해볼 때는 비워두고, 실제 예산 상한이 정해지면 총 토큰 수(예: 50000000)로
# 채우세요.
SOCIETY_CODE_MONTHLY_TOKEN_LIMIT=

# Reddit — app/api/cron/reddit-digest가 지정한 서브레딧의 새 글을 읽기 전용으로
# 가져오는 데만 사용합니다(댓글/게시글 작성 권한 없음). reddit.com/prefs/apps에서
# "create app" → type: script로 만들면 client id/secret이 발급됩니다(redirect uri는
# 아무 값이나 무방 — 읽기 전용이라 실제로 안 씀).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit이 요구하는 형식: "앱이름/버전 (by /u/본인아이디)". 이 헤더가 부실하면 Reddit이
# 요청을 강하게 rate-limit합니다.
REDDIT_USER_AGENT=carrotly-reddit-monitor/1.0 (by /u/본인아이디)

# Resend — 두 곳에서 씁니다(resend.com에서 API 키 발급):
#   1) app/api/cron/reddit-digest — 하루 한 번 다이제스트 이메일
#   2) app/api/webhooks/polar — 결제 웹훅이 2xx가 아닌 응답을 낼 때 즉시 알림 메일
#      (미설정이면 알림만 건너뛰고 콘솔 에러로 남습니다 — 웹훅 동작 자체에는 영향 없음)
RESEND_API_KEY=
# 다이제스트와 결제 실패 알림을 함께 받을 주소 — 결제 알림만 따로 받고 싶어지면
# 그때 별도 변수를 추가하세요(지금은 의도적으로 이 하나를 공유합니다).
DIGEST_EMAIL_TO=
# 발신 주소 — 본인 도메인을 Resend에 인증하기 전에는 onboarding@resend.dev로도
# 바로 보낼 수 있습니다.
DIGEST_EMAIL_FROM=onboarding@resend.dev
